{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/projects", "destination": "/projects/ongoing", "permanent": true },
    { "source": "/schedule-visit", "destination": "/contact#visit", "permanent": true },
    { "source": "/projects/xen-lakeview-tasmee", "destination": "/projects/lakeview-tasmee", "permanent": true },
    { "source": "/projects/project-41", "destination": "/projects/project-41-ctg", "permanent": true },
    { "source": "/projects/project-21", "destination": "/projects/project-21-banani", "permanent": true },
    { "source": "/projects/project-07", "destination": "/projects/project-07-jolshiri", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/(.*)", "destination": "/spa.html" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/video/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
